{
    "arguments": {
        "SNYK_TARGET": {"mandatory": true, "type": "string", "base": "string"},
        "SNYK_MODE": {"mandatory": false, "type": "string", "base": "string"},
        "SNYK_SEVERITY_THRESHOLD": {"mandatory": false, "type": "string", "base": "string"},
        "SNYK_ORG": {"mandatory": false, "type": "string", "base": "string"},
        "SNYK_FILE": {"mandatory": false, "type": "string", "base": "string"},
        "SNYK_ALL_PROJECTS": {"mandatory": false, "type": "boolean", "base": "boolean"}
    },
    "environment_variables": [
        "SNYK_TOKEN"
    ],
    "check_cmds": [
        "snyk --version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "snyk",
    "title": "Snyk",
    "website": "https://snyk.io/",
    "description": "Open source, container, IaC and code vulnerability scanner (SCA + SAST)",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "snyk.py"
}
