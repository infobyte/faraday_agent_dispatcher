{
    "arguments": {
        "KICS_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "KICS_TYPE": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "KICS_EXCLUDE_SEVERITIES": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "KICS_GIT_URL": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "KICS_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "kics version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "kics",
    "title": "KICS",
    "website": "https://kics.io/",
    "description": "Checkmarx KICS scanner for IaC misconfigurations across Terraform, Kubernetes, Dockerfile, CloudFormation, Ansible, and Helm. Point KICS_TARGET at a directory; restrict scope with KICS_TYPE (e.g. 'Terraform,Kubernetes') and drop noisy findings via KICS_EXCLUDE_SEVERITIES (CSV of severities like 'LOW,INFO').",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "kics.py"
}
