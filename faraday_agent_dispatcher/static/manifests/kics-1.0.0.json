{
    "arguments": {
        "KICS_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "KICS_TYPE": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "KICS_EXCLUDE_SEVERITIES": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "KICS_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "KICS_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "kics version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "kics",
    "title": "KICS",
    "website": "https://kics.io/",
    "description": "Checkmarx KICS scanner for IaC misconfigurations across Terraform, Kubernetes, Dockerfile, CloudFormation, Ansible, and Helm. Point KICS_TARGET at a directory. KICS_TYPE is a list of platforms to scan (e.g. Terraform, Kubernetes, Dockerfile, CloudFormation, Ansible, Helm). KICS_EXCLUDE_SEVERITIES is a list of severities to drop (e.g. LOW, INFO, TRACE).",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "kics.py"
}
