{
    "arguments": {
        "SNYK_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SNYK_MODE": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SNYK_SEVERITY_THRESHOLD": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SNYK_ORG": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SNYK_FILE": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SNYK_ALL_PROJECTS": {
            "mandatory": false,
            "type": "boolean",
            "base": "boolean"
        },
        "SNYK_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "SNYK_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SNYK_TOKEN": {
            "mandatory": false,
            "type": "password",
            "base": "string"
        },
        "GIT_USERNAME": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_TOKEN": {
            "mandatory": false,
            "type": "password",
            "base": "string"
        }
    },
    "environment_variables": [
        "SNYK_TOKEN",
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "snyk --version 2>&1"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "snyk",
    "title": "Snyk",
    "website": "https://snyk.io/",
    "description": "Dependency, IaC, container, and SAST scanner from Snyk. Pick what to scan with SNYK_MODE \u2014 valid values: test (deps) | code (SAST) | container (image) | iac. Set SNYK_TARGET to a path or image. SNYK_SEVERITY_THRESHOLD filters findings \u2014 valid values: low | medium | high | critical. SNYK_ALL_PROJECTS=true scans every manifest under the target. Requires a Snyk account token in the agent config (SNYK_TOKEN) \u2014 without it scans will fail to authenticate.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "snyk.py"
