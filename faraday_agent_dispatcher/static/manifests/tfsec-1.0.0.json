{
    "arguments": {
        "TFSEC_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TFSEC_MIN_SEVERITY": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TFSEC_EXCLUDE": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TFSEC_GIT_URL": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TFSEC_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "tfsec --version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
