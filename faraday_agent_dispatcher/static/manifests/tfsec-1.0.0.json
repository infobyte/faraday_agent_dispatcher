{
    "arguments": {
        "TFSEC_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TFSEC_MIN_SEVERITY": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TFSEC_EXCLUDE": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "TFSEC_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "TFSEC_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_USERNAME": {
            "mandatory": true,
            "type": "string",
            "base": "string"
        },
        "GIT_TOKEN": {
            "mandatory": true,
            "type": "password",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "tfsec --version 2>&1"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "tfsec",
    "title": "tfsec",
    "website": "https://aquasecurity.github.io/tfsec/",
    "description": "Static analysis for Terraform \u2014 detects AWS/Azure/GCP misconfigurations and best-practice violations. TFSEC_TARGET is the directory containing .tf files. TFSEC_MIN_SEVERITY filters by severity \u2014 valid values: LOW | MEDIUM | HIGH | CRITICAL. TFSEC_EXCLUDE is a list of check IDs to ignore (e.g. aws-s3-enable-bucket-encryption, aws-vpc-no-public-egress-sgr). Note: tfsec is being merged into Trivy upstream \u2014 use Trivy config-mode for new work.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "tfsec.py"
}
