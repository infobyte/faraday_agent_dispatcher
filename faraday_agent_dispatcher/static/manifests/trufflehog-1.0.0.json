{
    "arguments": {
        "TRUFFLEHOG_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TRUFFLEHOG_MODE": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TRUFFLEHOG_ONLY_VERIFIED": {
            "mandatory": false,
            "type": "boolean",
            "base": "boolean"
        },
        "TRUFFLEHOG_NO_UPDATE": {
            "mandatory": false,
            "type": "boolean",
            "base": "boolean"
        },
        "TRUFFLEHOG_GIT_URL": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "TRUFFLEHOG_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "trufflehog --version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "trufflehog",
    "title": "TruffleHog",
    "website": "https://github.com/trufflesecurity/trufflehog",
    "description": "Secrets scanner with verifier-backed credential validation (filesystem / git / docker / s3 / etc.)",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "trufflehog.py"
}
