{
    "arguments": {
        "GITLEAKS_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GITLEAKS_MODE": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GITLEAKS_CONFIG": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GITLEAKS_REDACT": {
            "mandatory": false,
            "type": "boolean",
            "base": "boolean"
        },
        "GITLEAKS_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "GITLEAKS_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_USERNAME": {
            "mandatory": true,
            "type": "string",
            "base": "string"
        },
        "GIT_TOKEN": {
            "mandatory": true,
            "type": "password",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "gitleaks version 2>&1"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "gitleaks",
    "title": "Gitleaks",
    "website": "https://github.com/gitleaks/gitleaks",
    "description": "Detects hard-coded secrets (API keys, tokens, private keys) in source code. GITLEAKS_MODE picks the scan kind \u2014 valid values: dir (filesystem walk) | git (scans the entire git history) | stdin (read from stdin). GITLEAKS_TARGET is the path (or subpath inside a clone); GITLEAKS_REDACT=true masks the actual secret values in the output. Use GITLEAKS_GIT_URL + GIT_USERNAME / GIT_TOKEN to clone private repositories at scan time.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "gitleaks.py"
}
