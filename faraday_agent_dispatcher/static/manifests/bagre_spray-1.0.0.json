    "category": "Network Tools",
    "name": "bagre_spray",
    "title": "Bagre Password Spray",
    "website": "https://intelx.io/",
    "description": "Validates leaked credentials from Bagre by spraying them against assets and services discovered in the Faraday workspace. Pulls credentials from the configured source (IntelX default \u2014 needs INTELX_API_KEY), enumerates targets via the Faraday REST API (FARADAY_URL / USER / PASSWORD / WORKSPACE), and authenticates over ssh/http/https/ftp/smb/smtp/imap/pop3. Lockout guardrails are on by default (max 3 attempts per user, 1000 total per run, 1s inter-attempt delay, excludes admin/administrator/root). Set BAGRE_PASSWORD_SPRAY_DRY_RUN=true to log planned attempts without authenticating. Run only against authorised targets.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "bagre_spray.py"
