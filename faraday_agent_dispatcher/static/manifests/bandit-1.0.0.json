{
    "arguments": {
        "BANDIT_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "BANDIT_CONFIDENCE": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "BANDIT_SEVERITY": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "BANDIT_SKIP": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "BANDIT_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "BANDIT_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "bandit --version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "bandit",
    "title": "Bandit",
    "website": "https://bandit.readthedocs.io/",
    "description": "Python source-code security scanner (SAST). Point BANDIT_TARGET at a file or directory (or a subpath inside a clone when using BANDIT_GIT_URL). Use BANDIT_SEVERITY / BANDIT_CONFIDENCE to filter results, and BANDIT_SKIP to ignore specific test IDs (e.g. B101,B301). Supports private-repo cloning at scan time via GIT_USERNAME / GIT_TOKEN in the agent config.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "bandit.py"
}
