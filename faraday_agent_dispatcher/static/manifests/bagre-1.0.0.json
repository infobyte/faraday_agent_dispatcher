    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Network Tools",
    "name": "bagre",
    "title": "Bagre Threat Intelligence",
    "website": "https://intelx.io/",
    "description": "Queries Bagre threat-intelligence sources for compromised credentials tied to a target domain. Default source is Intelligence X (intelx.io) \u2014 set INTELX_API_KEY as an agent env var; ClickHouse is an optional backend (BAGRE_SOURCE=clickhouse with CLICKHOUSE_* creds). Per-scan, set TARGET_DOMAIN (e.g. 'faradaysec') and optionally narrow with TARGET_SUBDOMAIN (LIKE wildcards), MAIL_DOMAIN, or URI_PATH. Emits one Faraday host per affected IP with the leaked credential as a vulnerability + linked credential record.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "bagre.py"
