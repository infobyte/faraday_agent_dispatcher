{
    "arguments": {
        "CHECKOV_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "CHECKOV_FRAMEWORK": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "CHECKOV_SKIP_CHECK": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "CHECKOV_CHECK": {
            "mandatory": false,
            "type": "list",
            "base": "list"
        },
        "CHECKOV_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "CHECKOV_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_USERNAME": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_TOKEN": {
            "mandatory": false,
            "type": "password",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "checkov --version 2>&1"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "checkov",
    "title": "Checkov",
    "website": "https://www.checkov.io/",
    "description": "Static analysis for Infrastructure-as-Code: Terraform, CloudFormation, Kubernetes, Helm, ARM, Dockerfile, and embedded secrets. Set CHECKOV_TARGET to a directory. CHECKOV_FRAMEWORK is a list of frameworks to scan (e.g. terraform, kubernetes, dockerfile, cloudformation, helm, ansible, arm, secrets). CHECKOV_SKIP_CHECK is a list of check IDs to skip (e.g. CKV_AWS_20, CKV_AWS_57). CHECKOV_CHECK restricts the scan to specific check IDs (e.g. CKV_AWS_18). Clone-at-scan via CHECKOV_GIT_URL + GIT_USERNAME / GIT_TOKEN.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "checkov.py"
}
