{
    "arguments": {
        "CHECKOV_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "CHECKOV_FRAMEWORK": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "CHECKOV_SKIP_CHECK": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "CHECKOV_CHECK": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "CHECKOV_GIT_URL": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "CHECKOV_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "checkov --version"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "checkov",
    "title": "Checkov",
    "website": "https://www.checkov.io/",
    "description": "Static analysis for Infrastructure-as-Code: Terraform, CloudFormation, Kubernetes, Helm, ARM, Dockerfile, and embedded secrets. Set CHECKOV_TARGET to a directory; restrict scope with CHECKOV_FRAMEWORK (CSV of frameworks) and skip noisy findings with CHECKOV_SKIP_CHECK (CSV of check IDs), or run only certain checks with CHECKOV_CHECK.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "checkov.py"
}
