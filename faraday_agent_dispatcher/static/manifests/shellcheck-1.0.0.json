{
    "arguments": {
        "SHELLCHECK_TARGET": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SHELLCHECK_SEVERITY": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SHELLCHECK_SHELL": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "SHELLCHECK_GIT_URL": {
            "mandatory": false,
            "type": "url",
            "base": "string"
        },
        "SHELLCHECK_GIT_REF": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_USERNAME": {
            "mandatory": false,
            "type": "string",
            "base": "string"
        },
        "GIT_TOKEN": {
            "mandatory": false,
            "type": "password",
            "base": "string"
        }
    },
    "environment_variables": [
        "GIT_USERNAME",
        "GIT_TOKEN"
    ],
    "check_cmds": [
        "shellcheck --version 2>&1"
    ],
    "cmd": "{EXECUTOR_FILE_PATH}",
    "category": "Source Code Analysis",
    "name": "shellcheck",
    "title": "ShellCheck",
    "website": "https://www.shellcheck.net/",
    "description": "Static analysis for shell scripts (bash, sh, dash, ksh). Point SHELLCHECK_TARGET at a single script or a directory \u2014 it recursively finds and lints every .sh. SHELLCHECK_SEVERITY sets the minimum reported level \u2014 valid values: error | warning | info | style. SHELLCHECK_SHELL forces a dialect \u2014 valid values: bash | sh | dash | ksh.",
    "image": null,
    "manifest_version": "1.0.0",
    "repo_executor": "shellcheck.py"
}
